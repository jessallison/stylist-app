# Set these in Vercel (Project > Settings > Environment Variables).
# Leave unset for local dev: data is held in memory and everything is editable,
# but AI tagging and suggestions need ANTHROPIC_API_KEY even locally.

# The app password - gates VIEWING as well as editing (the wardrobe is
# private). Pick anything you'll remember; share it with anyone who should
# be able to look.
ADMIN_PASSWORD=

# Anthropic API key (console.anthropic.com > API keys). Powers tag suggestions
# on entry and the outfit suggestion engine. Without it the app still works -
# you just tag everything by hand and there are no suggestions.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used (default claude-sonnet-4-5).
CLAUDE_MODEL=

# Optional: remove.bg API key (remove.bg > Account > API Key). Strips the
# background from wardrobe photos and composites the garment onto white, so
# the grid reads as a catalogue rather than phone snapshots. Wardrobe photos
# only - inspo and profile photos keep their real backgrounds on purpose.
# Without it the app still works - photos just keep whatever background they
# were shot on. Free tier includes 50 credits/month.
REMOVEBG_API_KEY=

# Added automatically when you connect Upstash Redis via the Vercel Marketplace.
# (KV_REST_API_URL / KV_REST_API_TOKEN also work.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
